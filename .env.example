# General
PROJECT_NAME="classy-arabic"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="classy_arabic"
POSTGRES_PORT=5432

# AI Tiers
# NILECHAT_BASE_URL points at a dedicated HF Inference Endpoint for
# MBZUAI-Paris/Nile-Chat-4B (it has no free HF serverless provider), e.g.
# "https://xxxxx.us-east-1.aws.endpoints.huggingface.cloud/v1"
NILECHAT_BASE_URL=""
NILECHAT_API_KEY=""
NILECHAT_MODEL="MBZUAI-Paris/Nile-Chat-4B"

# OPENROUTER_API_KEY is used for both DeepSeek escalation (chat completions)
# and embeddings (bge-m3) below.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
DEEPSEEK_MODEL="deepseek/deepseek-v4-flash"

EMBEDDING_MODEL="baai/bge-m3"

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
NILECHAT_CONTEXT_TOKEN_BUDGET=2048
CONTEXT_HISTORY_TURNS=10
