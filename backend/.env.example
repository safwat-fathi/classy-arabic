# General
PROJECT_NAME="TijaratkBot"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="tijaratk_bot"
POSTGRES_PORT=5432

# AI Tiers
# OPENROUTER_API_KEY is used for both the DeepSeek engine (chat completions)
# and embeddings (bge-m3) below.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
DEEPSEEK_MODEL="~deepseek/deepseek-v4-flash-latest"

EMBEDDING_MODEL="baai/bge-m3"

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CONTEXT_HISTORY_TURNS=10
DEEPSEEK_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]
