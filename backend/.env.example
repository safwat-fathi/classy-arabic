# General
PROJECT_NAME="TijaratkBot"

CORS_ORIGINS=["http://localhost:3000"]

# Demo merchant
AUTH_DEV_BYPASS_MERCHANT_ID="50064628-c874-41f9-9640-5591b955d17b"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="tijaratk_bot"
POSTGRES_PORT=5432

# AI Tiers
# OPENROUTER_API_KEY is used for both the DeepSeek engine (chat completions)
# and embeddings (bge-m3) below.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
DEEPSEEK_MODEL="~deepseek/deepseek-v4-flash-latest"

EMBEDDING_BASE_URL="http://localhost:11434/v1"
EMBEDDING_API_KEY="ollama"
EMBEDDING_MODEL="bge-m3"

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
CONTEXT_HISTORY_TURNS=10
DEEPSEEK_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
SQL_ECHO=false

REDIS_URL="redis://localhost:6379/0"

# Channel/Webhook Settings
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN=""
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_URL=""

# Auth Settings
JWT_SECRET_KEY=""
AUTH_DEV_BYPASS_MERCHANT_ID=""
