# General
PROJECT_NAME="classy-arabic"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="classy_arabic"
POSTGRES_PORT=5432

# AI Tiers
# NILECHAT points to your local Ollama server running the imported GGUF model:
NILECHAT_BASE_URL="http://localhost:11434/v1"
NILECHAT_API_KEY="ollama"
NILECHAT_MODEL="nilechat"

# OPENROUTER_API_KEY is used for both DeepSeek escalation (chat completions)
# and embeddings (bge-m3) below.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
DEEPSEEK_MODEL="~deepseek/deepseek-v4-flash-latest"

EMBEDDING_MODEL="baai/bge-m3"

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
NILECHAT_CONTEXT_TOKEN_BUDGET=2048
CONTEXT_HISTORY_TURNS=10
NILECHAT_TEMPERATURE=0.1
DEEPSEEK_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]
